{
  "name": "web3-lead-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "Automated Web3 project discovery and human-reviewed client prospecting platform.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
