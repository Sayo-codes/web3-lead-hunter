# --- Database mode ---
# "pglite" = zero-config local PostgreSQL (WASM) for development/preview. Uses real provider APIs, never fake data.
# "supabase" = production Supabase PostgreSQL. If SUPABASE_DB_URL is set, supabase mode is auto-selected.
DB_MODE=pglite
PGLITE_DATA_DIR=.data/pglite

# --- Supabase (production) ---
# Create a project at https://supabase.com/dashboard. Auth -> Providers -> Email enabled.
# Settings -> Database -> Connection string (URI). Use the direct or session pooler connection string.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[ANON_KEY]
# Optional: restrict the single-user app to one account email.
OWNER_EMAIL=you@example.com
# Optional SSL verification override for local proxies only. Keep true in production.
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Worker ---
# In pglite dev mode the worker runs inside Next.js instrumentation. In supabase mode run `npm run worker` separately.
DISABLE_IN_PROCESS_WORKER=false
WORKER_POLL_SECONDS=15
DISCOVERY_INTERVAL_MINUTES=3

# --- Provider options (all optional; keyless public endpoints work for development) ---
# DEX Screener public API needs no key. GeckoTerminal keyless is ~5-10 req/min and not recommended for production.
# For production GeckoTerminal/CoinGecko paid onchain access, set a CoinGecko key and GECKO_USE_PAID=true.
COINGECKO_API_KEY=
GECKO_USE_PAID=false
GECKO_RATE_LIMIT_PER_MIN=5
DEXSCREENER_RATE_LIMIT_PER_MIN=50
# Optional Telegram Bot API token for verifying chats the bot is already a member of. Never auto-joins.
TELEGRAM_BOT_TOKEN=
# Enable public t.me page checks to distinguish group/channel hints without joining. Respects robots and rate limits.
TELEGRAM_PUBLIC_PAGE_CHECKS=true
DISCORD_INVITE_CHECKS=true

# --- Secrets storage (optional UI-managed provider keys) ---
# 32-byte hex or base64 key used to encrypt provider_secrets at rest. Generate: openssl rand -hex 32
SECRETS_ENCRYPTION_KEY=

# --- App ---
NEXT_PUBLIC_APP_NAME=Web3 Lead Hunter
LOG_LEVEL=info
